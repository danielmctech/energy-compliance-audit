# --- Paths (optional - defaults to the repo root this script was started from) ---
# ENERGY_AUDIT_ROOT=/path/to/energy-audit

# --- Ollama (used by notebooks 02/03a for LLM structure extraction, cached) ---
# Base URL points at the Ollama host (no trailing /v1; the client is the raw chat API).
OLLAMA_BASE_URL=http://localhost:11434
ENERGY_AUDIT_REASONER=qwen3.8:27b
ENERGY_AUDIT_REASONER_BASELINE=deepseek-r1:32b

# --- RAG / dense retrieval ---
# Optional: additional dense encoder variants to fuse in hybrid mode.
# JSON list of {"name": "<label>", "model": "<local-path-or-hf-id>"}.
# Leave blank to use only the default all-MiniLM-L6-v2.
RETRIEVAL_EXTRA_DENSE=
# Example:
# RETRIEVAL_EXTRA_DENSE=[{"name":"finetuned_stage1","model":"notebooks/data/retrieval/finetuned_stage1/adapter"},{"name":"finetuned_stage2","model":"notebooks/data/retrieval/finetuned_stage2/adapter"}]

# --- Neo4j GraphRAG layer (P0+) ---
# Local Neo4j (Community 5.26 LTS). Set NEO4J_PASSWORD to your generated password.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# neo4j-graphrag talks to Ollama through its OpenAI-compatible endpoint.
# OLLAMA_OPENAI_BASE_URL defaults to <OLLAMA_BASE_URL>/v1 when unset.
# NEO4J_GRAPHRAAG_API_KEY is a placeholder (Ollama ignores the value).
# GRAPHRAAG_LLM_MODEL defaults to ENERGY_AUDIT_REASONER.
GRAPHRAAG_EMBEDDING_MODEL=bge-m3
GRAPHRAAG_EMBEDDING_DIM=1024
