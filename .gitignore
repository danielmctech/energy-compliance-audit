# Generated audit outputs
outputs/

# ---- ALL notebooks/data/ artifacts (regenerated by notebooks 01-08 + scripts) ----
# Every file under notebooks/data/ is produced by the notebook pipeline or an
# evaluation script. None are hand-authored; all can be rebuilt from scratch
# by re-running the relevant notebook + scripts. Excluded entirely to keep
# the repo lightweight and avoid pushing experimental/historical runs.
#
# To regenerate:
#   1. python scripts/build_heldout_benchmark_artifacts.py   (60 + 160 query defs)
#   2. python scripts/rerun_retrieval_and_tables.py          (retrieval + tables A-D)
#   3. python scripts/run_heldout_systems.py                 (held-out retrieval + stats)
#   4. python scripts/analyze_heldout_run.py                 (per-query comparison)
#   5. python scripts/make_gcg_2hop_report.py                (GCG diagnostic reports)
#      (plus individual scripts/make_gcg_*.py for each ablation)
#   6. Jupyter kernel: run notebooks 01-08 in order
notebooks/data/

# Transient / backup / scratch files (any directory)
*.bak*
*.stale_*
backup_*/

# Ollama model files (managed by ollama CLI, not git)
*.gguf
*.bin

